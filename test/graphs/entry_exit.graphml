<?xml version="1.0" encoding="UTF-8"?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns">
  <data key="gFormat">Cyberiada-GraphML-1.0</data>
  <key id="gFormat" for="graphml" attr.name="format" attr.type="string"/>
  <key id="dName" for="graph" attr.name="name" attr.type="string"/>
  <key id="dName" for="node" attr.name="name" attr.type="string"/>
  <key id="dStateMachine" for="graph" attr.name="stateMachine" attr.type="string"/>
  <key id="dRegion" for="graph" attr.name="region" attr.type="string"/>
  <key id="dSubmachineState" for="node" attr.name="submachineState" attr.type="string"/>
  <key id="dNote" for="node" attr.name="note" attr.type="string"/>
  <key id="dVertex" for="node" attr.name="vertex" attr.type="string"/>
  <key id="dData" for="node" attr.name="data" attr.type="string"/>
  <key id="dData" for="edge" attr.name="data" attr.type="string"/>
  <key id="dPivot" for="edge" attr.name="pivot" attr.type="string"/>
  <key id="dChunk" for="edge" attr.name="chunk" attr.type="string"/>
  <key id="dCollapsed" for="node" attr.name="collapsed" attr.type="string"/>
  <key id="dMarkup" for="node" attr.name="markup" attr.type="string"/>
  <key id="dColor" for="node" attr.name="color" attr.type="string"/>
  <key id="dColor" for="edge" attr.name="color" attr.type="string"/>
  <key id="dFormalName" for="graph" attr.name="formalName" attr.type="string"/>
  <key id="dFormalName" for="node" attr.name="formalName" attr.type="string"/>
  <graph id="G" edgedefault="directed">
    <data key="dStateMachine"/>
    <data key="dName">cpu</data>
    <node id="nMeta">
      <data key="dNote">formal</data>
      <data key="dName">CGML_META</data>
      <data key="dData">standardVersion/ 1.0

name/ cpu

transitionOrder/ exitFirst

eventPropagation/ block</data>
    </node>
    <node id="n0">
      <data key="dName">cpu</data>
      <data key="dData">entry/
debug('ENTRY A')
</data>
      <graph id="n0:" edgedefault="directed">
        <node id="n0::n0">
          <data key="dName">B</data>
          <data key="dData">entry/
debug('ENTRY B')
</data>
        </node>
        <node id="n0::n1">
          <data key="dName">C</data>
          <data key="dData">entry/
debug('ENTRY C')
</data>
          <graph id="n0::n1:" edgedefault="directed">
            <node id="n0::n1::n0">
              <data key="dName">D</data>
              <data key="dData">entry/
debug('ENTRY D')

exit/
debug('EXIT D')
</data>
            </node>
            <node id="n0::n1::n1">
              <data key="dName">E</data>
              <data key="dData">entry/
debug('ENTRY E')
</data>
              <graph id="n0::n1::n1:" edgedefault="directed">
                <node id="n0::n1::n1::n0">
                  <data key="dName">F</data>
                  <data key="dData">entry/
debug('ENTRY F')
global foo
foo = foo - 1
</data>
                </node>
                <node id="n0::n1::n1::n1">
                  <data key="dName">G</data>
                  <data key="dData">entry/
debug('ENTRY G')
global foo
foo = foo + 1
</data>
                </node>
                <node id="n0::n1::n1::n2">
                  <data key="dVertex">initial</data>
                  <data key="dName"></data>
                </node>
              </graph>
            </node>
          </graph>
        </node>
      </graph>
    </node>
    <node id="n1">
      <data key="dVertex">initial</data>
      <data key="dName"></data>
    </node>
    <node id="n2">
      <data key="dNote">informal</data>
      <data key="dData">Global Initialization

debug = print

foo = 1
debug('INIT')</data>
    </node>
    <node id="n3">
      <data key="dVertex">final</data>
      <data key="dName"></data>
    </node>
    <edge id="e0" source="n1" target="n0::n0"/>
    <edge id="n0::e0" source="n0::n0" target="n0::n1::n0">
      <data key="dData">TIME_TICK [foo == 1]/
debug('B-&gt;C')
global foo
foo = 2
</data>
    </edge>
    <edge id="n0::n1::e0" source="n0::n1::n1" target="n0::n1::n0">
      <data key="dData">TIME_TICK [foo == 1]/</data>
    </edge>
    <edge id="n0::n1::e1" source="n0::n1::n0" target="n0::n1::n1">
      <data key="dData">TIME_TICK [foo != 1]/</data>
    </edge>
    <edge id="n0::n1::n1::e0" source="n0::n1::n1::n2" target="n0::n1::n1::n0"/>
    <edge id="n0::n1::n1::e1" source="n0::n1::n1::n0" target="n0::n1::n1::n1">
      <data key="dData">TIME_TICK [foo &lt; 1]/</data>
    </edge>
    <edge id="n0::n1::n1::e2" source="n0::n1::n1::n1" target="n0::n1::n1::n0">
      <data key="dData">TIME_TICK [foo &gt;1]/</data>
    </edge>
    <edge id="e1" source="n0::n1::n0" target="n3">
      <data key="dData">TIME_TICK [foo == 1]/
debug('TERM')
</data>
    </edge>
  </graph>
</graphml>
